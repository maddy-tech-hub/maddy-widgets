  "scripts": {
    "start": "webpack serve --hot --open --env FMR=false",
    "prebuild": "npm install -D webpack-cli",
    "build": "npx webpack --config webpack.config.js --mode production",
    "husky-install": "husky install",
    "lint": "npx eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npx eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "prettier": "prettier \"src/**/*.{ts,tsx,js,jsx}\" --check",
    "prettier:fix": "prettier \"src/**/*.{ts,tsx,js,jsx}\" --write",
    "lint:all": "npm run lint && npm run prettier:fix",
    "test": "npx jest",
    "test:coverage": "npx jest --coverage --watchAll=false --testResultsProcessor",
    "clean": "rimraf dist",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --fix",
      "npx prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
